POSTGRES_DB=water_app
POSTGRES_USER=water_user
POSTGRES_PASSWORD=change_me

INFLUX_USERNAME=water_admin
INFLUX_PASSWORD=change_me
INFLUX_ORG=water-monitoring
INFLUX_BUCKET=water-data
INFLUX_TOKEN=change_me
INFLUX_MEASUREMENT=water_telemetry

JWT_SECRET_KEY=change_me_use_a_long_random_value
DATABASE_URL=postgresql+psycopg://water_user:change_me@postgres:5432/water_app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INITIAL_ADMIN_NAME=Admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_me_admin
INITIAL_ADMIN_FLOOR=PB

MQTT_TOPIC_FILTER=water/flow/+/+/telemetry
MQTT_QOS=1
SITE=indatta
INTERVAL_SEC=30
